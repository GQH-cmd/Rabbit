# 一键FEED：o0,v100下降→新接触停机→奶泵定时运行→o0,v-100回程→第二次新接触停机。
# 两段使用当前M1≤65 RPM接触判定；不含M0横移、清洗或两笼调度。
# 奶泵开启时长，单位毫秒。用户确认测试先开3秒，不代表正式供奶剂量；0禁止开泵。
FEED_MILK_RUN_MS=3000
# 安全最长开启时长，单位毫秒；不是正式喂奶时间，允许范围1..30000。
FEED_MAX_MILK_MS=30000
# 实际下降时FOC回传M1转速的符号：1正，-1负；未知保持0，拒绝FEED。
# 2026-10-14用户确认：实际下降的反馈转速为正；这不是电机指令符号。
FEED_DOWN_RPM_SIGN=1
# 等待下降运动、等待新接触、确认停止的最大时间，单位毫秒。
FEED_WAIT_MOTION_MS=30000
FEED_CONTACT_TIMEOUT_MS=15000
FEED_STOP_TIMEOUT_MS=3000
# FOC反馈最大允许年龄，单位毫秒；保留当前100ms SPI轮询。
FEED_MAX_FEEDBACK_AGE_MS=500
# 连续有效运动采样数和连续停稳采样数，重复帧不算新样本。
FEED_MOVING_SAMPLES=2
FEED_STOPPED_SAMPLES=3
