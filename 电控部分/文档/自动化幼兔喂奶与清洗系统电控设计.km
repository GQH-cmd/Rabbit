{
  "root": {
    "data": {
      "id": "root",
      "created": 1778515200000,
      "text": "自动化幼兔喂奶与清洗系统电控设计"
    },
    "children": [
      {
        "data": {
          "id": "n002",
          "created": 1778515200000,
          "text": "系统总体流程"
        },
        "children": [
          {
            "data": {
              "id": "n002-001",
              "created": 1778515200000,
              "text": "系统上电，单片机初始化"
            }
          },
          {
            "data": {
              "id": "n002-002",
              "created": 1778515200000,
              "text": "平台回零，确认初始位置"
            }
          },
          {
            "data": {
              "id": "n002-003",
              "created": 1778515200000,
              "text": "丝杆滑台移动到指定兔笼工位"
            }
          },
          {
            "data": {
              "id": "n002-004",
              "created": 1778515200000,
              "text": "下压机构短时动作，兔毛接触幼兔"
            }
          },
          {
            "data": {
              "id": "n002-004a",
              "created": 1778515200000,
              "text": "通过FOC电流变化判断是否已经接触"
            }
          },
          {
            "data": {
              "id": "n002-005",
              "created": 1778515200000,
              "text": "蠕动泵正转供奶"
            }
          },
          {
            "data": {
              "id": "n002-006",
              "created": 1778515200000,
              "text": "喂奶结束，蠕动泵反转回吸残奶"
            }
          },
          {
            "data": {
              "id": "n002-007",
              "created": 1778515200000,
              "text": "清洁剂和清水依次冲洗管路"
            }
          },
          {
            "data": {
              "id": "n002-008",
              "created": 1778515200000,
              "text": "移动到下一个工位，循环执行"
            }
          }
        ]
      },
      {
        "data": {
          "id": "n003",
          "created": 1778515200000,
          "text": "控制核心：单片机"
        },
        "children": [
          {
            "data": {
              "id": "n003-001",
              "created": 1778515200000,
              "text": "实际选用：STM32F407VET6"
            },
            "children": [
              {
                "data": {
                  "id": "n003-001-001",
                  "created": 1778515200000,
                  "text": "作为整套电控系统的主控芯片"
                }
              },
              {
                "data": {
                  "id": "n003-001-002",
                  "created": 1778515200000,
                  "text": "负责协调电机、泵、电磁阀和传感器"
                }
              },
              {
                "data": {
                  "id": "n003-001-003",
                  "created": 1778515200000,
                  "text": "IO口资源充足，适合多路输入输出控制"
                }
              },
              {
                "data": {
                  "id": "n003-001-004",
                  "created": 1778515200000,
                  "text": "定时器和PWM资源丰富，便于步进电机脉冲与定时控制"
                }
              },
              {
                "data": {
                  "id": "n003-001-005",
                  "created": 1778515200000,
                  "text": "性能和扩展能力满足后续功能升级"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n003-003",
              "created": 1778515200000,
              "text": "主要控制任务"
            },
            "children": [
              {
                "data": {
                  "id": "n003-003-001",
                  "created": 1778515200000,
                  "text": "输出脉冲和方向信号控制步进电机"
                }
              },
              {
                "data": {
                  "id": "n003-003-002",
                  "created": 1778515200000,
                  "text": "控制下压电机带动丝杆完成下压与回位"
                }
              },
              {
                "data": {
                  "id": "n003-003-003",
                  "created": 1778515200000,
                  "text": "控制蠕动泵正转供奶和反转回吸"
                }
              },
              {
                "data": {
                  "id": "n003-003-004",
                  "created": 1778515200000,
                  "text": "控制清洁剂泵、清水泵及各路电磁阀"
                }
              },
              {
                "data": {
                  "id": "n003-003-005",
                  "created": 1778515200000,
                  "text": "读取限位开关、FOC电流采样和保护信号"
                }
              },
              {
                "data": {
                  "id": "n003-003-006",
                  "created": 1778515200000,
                  "text": "按照设定时间和顺序执行完整流程"
                }
              }
            ]
          }
        ]
      },
      {
        "data": {
          "id": "n004",
          "created": 1778515200000,
          "text": "水平移动控制"
        },
        "children": [
          {
            "data": {
              "id": "n004-001",
              "created": 1778515200000,
              "text": "结构：步进电机 + 丝杆 + 直线导轨"
            }
          },
          {
            "data": {
              "id": "n004-002",
              "created": 1778515200000,
              "text": "电控链路"
            },
            "children": [
              {
                "data": {
                  "id": "n004-002-001",
                  "created": 1778515200000,
                  "text": "单片机输出脉冲信号PUL"
                }
              },
              {
                "data": {
                  "id": "n004-002-002",
                  "created": 1778515200000,
                  "text": "单片机输出方向信号DIR"
                }
              },
              {
                "data": {
                  "id": "n004-002-003",
                  "created": 1778515200000,
                  "text": "步进电机驱动器接收信号"
                }
              },
              {
                "data": {
                  "id": "n004-002-004",
                  "created": 1778515200000,
                  "text": "步进电机带动丝杆旋转"
                }
              },
              {
                "data": {
                  "id": "n004-002-005",
                  "created": 1778515200000,
                  "text": "丝杆螺母带动滑台水平移动"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n004-003",
              "created": 1778515200000,
              "text": "定位方式"
            },
            "children": [
              {
                "data": {
                  "id": "n004-003-001",
                  "created": 1778515200000,
                  "text": "通过脉冲数控制移动距离"
                }
              },
              {
                "data": {
                  "id": "n004-003-002",
                  "created": 1778515200000,
                  "text": "通过方向信号控制正反转"
                }
              },
              {
                "data": {
                  "id": "n004-003-003",
                  "created": 1778515200000,
                  "text": "通过限位开关进行开机回零"
                }
              },
              {
                "data": {
                  "id": "n004-003-004",
                  "created": 1778515200000,
                  "text": "不同工位对应不同步数"
                }
              }
            ]
          }
        ]
      },
      {
        "data": {
          "id": "n005",
          "created": 1778515200000,
          "text": "电机丝杆下压提示控制"
        },
        "children": [
          {
            "data": {
              "id": "n005-001",
              "created": 1778515200000,
              "text": "执行部件：下压电机 + 丝杆机构"
            }
          },
          {
            "data": {
              "id": "n005-002",
              "created": 1778515200000,
              "text": "辅助结构：导向杆、直线滑轨、浮动平台"
            }
          },
          {
            "data": {
              "id": "n005-003",
              "created": 1778515200000,
              "text": "动作逻辑"
            },
            "children": [
              {
                "data": {
                  "id": "n005-003-001",
                  "created": 1778515200000,
                  "text": "单片机控制下压电机低速转动"
                }
              },
              {
                "data": {
                  "id": "n005-003-002",
                  "created": 1778515200000,
                  "text": "丝杆带动平台缓慢下降，兔毛轻触幼兔"
                }
              },
              {
                "data": {
                  "id": "n005-003-003",
                  "created": 1778515200000,
                  "text": "FOC电流采样判断是否已经接触"
                }
              },
              {
                "data": {
                  "id": "n005-003-004",
                  "created": 1778515200000,
                  "text": "接触确认后停止下压，短暂停留后电机反转回位"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n005-004",
              "created": 1778515200000,
              "text": "注意：下压机构只负责提示与接触检测，不参与输奶"
            }
          }
        ]
      },
      {
        "data": {
          "id": "n005a",
          "created": 1778515200000,
          "text": "接触检测控制"
        },
        "children": [
          {
            "data": {
              "id": "n005a-001",
              "created": 1778515200000,
              "text": "检测目的"
            },
            "children": [
              {
                "data": {
                  "id": "n005a-001-001",
                  "created": 1778515200000,
              "text": "判断兔毛接触区域是否已经接触幼兔"
                }
              },
              {
                "data": {
                  "id": "n005a-001-002",
                  "created": 1778515200000,
                  "text": "接触后停止继续下压，避免压力过大"
                }
              },
              {
                "data": {
                  "id": "n005a-001-003",
                  "created": 1778515200000,
                  "text": "作为下压动作的安全保护信号"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n005a-002",
              "created": 1778515200000,
              "text": "FOC检测原理"
            },
            "children": [
              {
                "data": {
                  "id": "n005a-002-001",
                  "created": 1778515200000,
                  "text": "电机带动机构低速下压"
                }
              },
              {
                "data": {
                  "id": "n005a-002-002",
                  "created": 1778515200000,
                  "text": "未接触时负载较小，电流变化不明显"
                }
              },
              {
                "data": {
                  "id": "n005a-002-003",
                  "created": 1778515200000,
              "text": "接触幼兔后阻力增大，q轴电流iq上升"
                }
              },
              {
                "data": {
                  "id": "n005a-002-004",
                  "created": 1778515200000,
                  "text": "STM32通过ADC采样电流并与阈值比较"
                }
              },
              {
                "data": {
                  "id": "n005a-002-005",
                  "created": 1778515200000,
                  "text": "超过阈值则判定已经接触"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n005a-003",
              "created": 1778515200000,
              "text": "FOC资料对应内容"
            },
            "children": [
              {
                "data": {
                  "id": "n005a-003-001",
                  "created": 1778515200000,
                  "text": "主控芯片：STM32F407VET6"
                }
              },
              {
                "data": {
                  "id": "n005a-003-002",
                  "created": 1778515200000,
                  "text": "电流采样：M0_ADC_A/B/C、M1_ADC_A/B/C"
                }
              },
              {
                "data": {
                  "id": "n005a-003-003",
                  "created": 1778515200000,
              "text": "编码器反馈：磁编码器位置反馈"
                }
              },
              {
                "data": {
                  "id": "n005a-003-004",
                  "created": 1778515200000,
                  "text": "控制方式：串口发送o/c/v/p命令"
                }
              },
              {
                "data": {
                  "id": "n005a-003-005",
                  "created": 1778515200000,
                  "text": "工程中已有电流采样、速度环和位置环"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n005a-004",
              "created": 1778515200000,
              "text": "接触检测流程"
            },
            "children": [
              {
                "data": {
                  "id": "n005a-004-001",
                  "created": 1778515200000,
                  "text": "启动低速下压"
                }
              },
              {
                "data": {
                  "id": "n005a-004-002",
                  "created": 1778515200000,
              "text": "实时采集q轴电流iq值"
                }
              },
              {
                "data": {
                  "id": "n005a-004-003",
                  "created": 1778515200000,
                  "text": "滤波后与设定阈值比较"
                }
              },
              {
                "data": {
                  "id": "n005a-004-004",
                  "created": 1778515200000,
                  "text": "达到阈值后停止下压"
                }
              },
              {
                "data": {
                  "id": "n005a-004-005",
                  "created": 1778515200000,
              "text": "按状态执行提示、喂奶、回位动作"
                }
              }
            ]
          }
        ]
      },
      {
