            },
            "children": [
              {
                "data": {
                  "id": "n008-001-001",
                  "created": 1778515200000,
                  "text": "用于开机回零"
                }
              },
              {
                "data": {
                  "id": "n008-001-002",
                  "created": 1778515200000,
                  "text": "防止滑台越位"
