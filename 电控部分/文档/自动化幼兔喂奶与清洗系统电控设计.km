              "text": "控制逻辑"
            },
            "children": [
              {
                "data": {
                  "id": "n006-003-001",
                  "created": 1778515200000,
                  "text": "蠕动泵正转，开始供奶"
                }
              },
              {
                "data": {
                  "id": "n006-003-002",
                  "created": 1778515200000,
                  "text": "达到设定喂奶时间后停止"
                }
              },
              {
                "data": {
                  "id": "n006-003-003",
                  "created": 1778515200000,
                  "text": "蠕动泵反转1到3秒，回吸残奶"
                }
              },
              {
                "data": {
                  "id": "n006-003-004",
                  "created": 1778515200000,
                  "text": "减少奶嘴滴漏和管路残留"
                }
              }
            ]
          }
        ]
      },
      {
        "data": {
          "id": "n007",
          "created": 1778515200000,
          "text": "清洗控制"
        },
        "children": [
          {
            "data": {
              "id": "n007-001",
              "created": 1778515200000,
              "text": "组成部件"
            },
            "children": [
              {
                "data": {
                  "id": "n007-001-001",
