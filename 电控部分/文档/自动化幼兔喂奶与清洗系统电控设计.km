              },
              {
                "data": {
                  "id": "n007-001-006",
                  "created": 1778515200000,
                  "text": "奶路阀、清洁剂阀、清水阀和废液阀均采用电磁阀控制"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n007-002",
              "created": 1778515200000,
              "text": "清洗流程"
            },
            "children": [
              {
                "data": {
                  "id": "n007-002-001",
                  "created": 1778515200000,
                  "text": "喂奶结束并回吸残奶"
                }
              },
              {
                "data": {
                  "id": "n007-002-002",
                  "created": 1778515200000,
                  "text": "打开清洁剂电磁阀，并启动清洁剂泵"
                }
              },
              {
                "data": {
                  "id": "n007-002-003",
                  "created": 1778515200000,
                  "text": "清洁剂冲洗管路和奶嘴"
                }
              },
              {
                "data": {
                  "id": "n007-002-004",
                  "created": 1778515200000,
                  "text": "打开清水电磁阀，并启动清水泵"
                }
              },
              {
                "data": {
                  "id": "n007-002-005",
                  "created": 1778515200000,
                  "text": "清水二次冲洗"
                }
              },
              {
                "data": {
                  "id": "n007-002-006",
                  "created": 1778515200000,
                  "text": "废液排入废液槽"
                }
              }
            ]
          },
          {
            "data": {
              "id": "n007-003",
              "created": 1778515200000,
              "text": "防污染措施"
